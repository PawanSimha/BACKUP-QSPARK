# Runtime environment: development | production
APP_ENV=development

# REQUIRED in production (app refuses to start without it when APP_ENV=production).
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me_in_production

DATABASE_PATH=database/parking_local.db
DB_BACKEND=sqlite
SESSION_TIMEOUT=3600
MAX_CONTENT_LENGTH=1048576

# Set to 1 only when the site is served over HTTPS (adds the Secure cookie flag).
SESSION_COOKIE_SECURE=0

# Seed credentials (used by `python seed.py`). Leave blank to have seed.py
# generate a random password per account and print it once.
QSPARK_ADMIN_USERS=admin1,admin2,admin3
QSPARK_ADMIN_EMAILS=admin1@qspark.com,admin2@qspark.com,admin3@qspark.com
QSPARK_ADMIN_NAMES=Admin One,Admin Two,Admin Three
# QSPARK_ADMIN1_PASSWORD=
# QSPARK_ADMIN2_PASSWORD=
# QSPARK_ADMIN3_PASSWORD=

QSPARK_SUPER_ADMIN_USERNAME=superadmin
QSPARK_SUPER_ADMIN_EMAIL=superadmin@qspark.com
QSPARK_SUPER_ADMIN_NAME=Super Admin
# QSPARK_SUPER_ADMIN_PASSWORD=
